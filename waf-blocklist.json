{
  "schema_version": 1,
  "policy": {
    "time_format": "RFC3339 UTC",
    "day_length_hours": 24,
    "first_block_days": {
      "TW": 7,
      "non_TW": 60
    },
    "second_block_days": 90,
    "third_block_days": 300,
    "permanent_from_block_number": 4,
    "count_repeat_only_after_prior_block_ended": true,
    "count_new_requests_during_active_block": false,
    "retain_expired_entry_for_repeat_count": true,
    "unknown_country_action": "defer_until_verified",
    "active_when": "blocked_at <= utc_now and released_at == null and (expires_at == null or utc_now < expires_at)"
  },
  "entry_fields": {
    "country_code_at_block": "ISO 3166-1 alpha-2",
    "block_number": "integer, starting at 1",
    "blocked_at": "RFC3339 UTC",
    "expires_at": "RFC3339 UTC; null from block 4 onward",
    "released_at": "RFC3339 UTC for manual release; otherwise null"
  },
  "entries": {}
}
